APP_NAME=ML Workflow API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

# Local Docker Postgres default (no TLS). For production-like envs, use DATABASE_SSL_MODE=verify-full.
DATABASE_URL=postgresql+asyncpg://devuser:devpass@db:5432/devdb
DATABASE_SSL_MODE=disable
# DATABASE_SSL_ROOT_CERT=/run/secrets/db_ca.pem

# Alternative for Supabase-backed DB mode:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL_MODE=require

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=replace-with-non-committed-secret
SUPABASE_STORAGE_BUCKET=attachments

BOOTSTRAP_ADMIN_EMAILS=admin@example.com

