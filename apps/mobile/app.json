{
  "expo": {
    "name": "ML Workflow",
    "slug": "ml-workflow-mobile",
    "scheme": "mlworkflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ml-workflow-mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.mlworkflowmobile"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "81f8c758-ec26-43e0-8b2a-bc1233d54b73"
      }
    },
    "owner": "nandansapps"
  }
}
