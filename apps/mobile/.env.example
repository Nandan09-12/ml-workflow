# Web browser
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# iOS Simulator on macOS
EXPO_PUBLIC_API_BASE_URL_IOS=http://127.0.0.1:8000

# Android Emulator
EXPO_PUBLIC_API_BASE_URL_ANDROID=http://10.0.2.2:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Only needed when Metro itself is running in Docker or when testing on a physical device
REACT_NATIVE_PACKAGER_HOSTNAME=your-lan-ip
